  "scripts": {
    "test": "node --test test/wire.test.mjs test/service.test.mjs test/oidc.test.mjs test/login.test.mjs test/update.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
